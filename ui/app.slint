import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";

export struct Fila {
    celdas: [string],
}

// Par id+nombre de un asesor, usado por CampoAsesor para el autocompletado
// (buscar por nombre o por ID y mostrar sugerencias).
export struct AsesorOpcion {
    id: string,
    nombre: string,
}

component KpiCard inherits Rectangle {
    in property <string> etiqueta;
    in property <string> valor;
    background: #1e1e2e;
    border-radius: 10px;
    border-width: 1px;
    border-color: #33334d;
    VerticalBox {
        alignment: center;
        Text { text: root.valor; font-size: 26px; font-weight: 700; color: #ffffff; horizontal-alignment: center; }
        Text { text: root.etiqueta; font-size: 13px; color: #a0a0c0; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component TablaGenerica inherits Rectangle {
    in property <[string]> headers;
    in property <[Fila]> rows;
    callback eliminar(int);
    callback editar(int);

    // Confirmacion de borrado: primer toque arma, segundo toque confirma.
    property <int> fila-a-confirmar: -1;
    // Fila "fijada" por un toque (para pantallas tactiles, sin hover).
    // -1 = ninguna fijada a mano; el detalle tambien aparece solo con hover.
    property <int> fila-fijada: -1;
    changed rows => { root.fila-a-confirmar = -1; root.fila-fijada = -1; }

    // Ancho de columna COMPARTIDO por el header y todas las filas: es lo
    // que garantiza que todo quede alineado en columnas prolijas en vez de
    // que cada fila calcule su propio ancho segun su propio contenido (eso
    // era lo que antes generaba el desalineado / cosas empujadas de mas
    // hacia la derecha). 138px = 60px (boton Editar) + 78px (boton Eliminar).
    property <length> ancho-columna: (root.width - 138px - 24px) / max(1, root.headers.length);

    VerticalBox {
        padding: 0px;
        spacing: 4px;

        HorizontalBox {
            padding: 6px;
            spacing: 0px;
            for h in root.headers: Text {
                text: h;
                width: root.ancho-columna;
                horizontal-stretch: 0;
                font-size: 12px;
                font-weight: 700;
                color: #a0a0c0;
                overflow: elide;
                wrap: no-wrap;
            }
            Text { text: ""; width: 60px; }
            Text { text: ""; width: 78px; }
        }

        Rectangle { height: 1px; background: #33334d; }

        ScrollView {
            VerticalBox {
                padding: 0px;
                spacing: 2px;
                alignment: start;
                for fila[i] in root.rows: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    Rectangle {
                        height: 34px;
                        vertical-stretch: 0;
                        background: mod(i, 2) == 0 ? #1a1a26 : transparent;

                        // Area invisible detras de todo: capta hover (mouse)
                        // y toque, pero los botones de arriba siguen
                        // funcionando normal porque ellos reciben el click
                        // primero al estar dibujados encima.
                        toque-fila := TouchArea {
                            clicked => {
                                root.fila-fijada = root.fila-fijada == i ? -1 : i;
                            }
                        }

                        HorizontalBox {
                            padding: 6px;
                            spacing: 0px;
                            for celda in fila.celdas: Text {
                                text: celda;
                                width: root.ancho-columna;
                                horizontal-stretch: 0;
                                font-size: 12px;
                                color: #e0e0f0;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                            Button { text: "Editar"; width: 60px; vertical-stretch: 0; clicked => { root.editar(i); } }
                            Button {
                                text: root.fila-a-confirmar == i ? "¿Seguro?" : "Eliminar";
                                width: 78px;
                                vertical-stretch: 0;
                                clicked => {
                                    if root.fila-a-confirmar == i {
                                        root.fila-a-confirmar = -1;
                                        root.eliminar(i);
                                    } else {
                                        root.fila-a-confirmar = i;
                                    }
                                }
                            }
                        }
                    }

                    // Cuadro de detalle: se muestra al pasar el mouse por
                    // encima de la fila (has-hover, en desktop) o al
                    // tocarla (fila-fijada, en pantallas tactiles). Muestra
                    // cada columna completa sin recortar, util cuando un
                    // nombre largo u otro dato queda cortado en la vista
                    // general de la tabla.
                    if toque-fila.has-hover || root.fila-fijada == i: Rectangle {
                        background: #23233a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #3a3a55;
                        VerticalBox {
                            padding: 8px;
                            spacing: 2px;
                            for h[idx] in root.headers: Text {
                                text: h + ": " + fila.celdas[idx];
                                font-size: 12px;
                                color: #e0e0f0;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> etiqueta;
    in property <bool> activo;
    callback clicked();
    height: 38px;
    background: root.activo ? #2a2a40 : transparent;
    border-radius: 6px;
    Text {
        text: root.etiqueta;
        color: root.activo ? #ffffff : #a0a0c0;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 10px;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Campo de texto con etiqueta, para los 3 formularios de alta.
component CampoTexto inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <string> valor <=> entrada.text;
    height: 32px;
    Text { text: root.etiqueta; width: 130px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
    entrada := LineEdit { horizontal-stretch: 1; }
}

// Checkbox con etiqueta, para publicado_web / publicado_rrss.
component CampoCheck inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <bool> valor <=> caja.checked;
    height: 32px;
    caja := CheckBox { text: root.etiqueta; }
}

// Campo numerico: igual que CampoTexto pero avisa en la propia etiqueta que
// solo se espera un numero. El bloqueo real (no guardar si no es numero) se
// hace en Rust al momento de guardar (parse_numero / parse_numero_obligatorio).
component CampoNumero inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <string> valor <=> entrada.text;
    height: 32px;
    Text { text: root.etiqueta + " (número)"; width: 190px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
    entrada := LineEdit { horizontal-stretch: 1; placeholder-text: "0"; }
}

// Campo de seleccion (lista fija): evita errores de tipeo en estatus/tipo,
// que ademas la logica de negocio compara con strings exactos (ej. "Venta",
// "Pagado"). El valor viaje igual que en CampoTexto (string plano), asi que
// el lado Rust no necesita cambios: solo cambia el widget visual.
component CampoSelector inherits HorizontalBox {
    in property <string> etiqueta;
    in property <[string]> opciones;
    in-out property <string> valor <=> combo.current-value;
    height: 32px;
    Text { text: root.etiqueta; width: 190px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
    combo := ComboBox { model: root.opciones; horizontal-stretch: 1; }
}

// Selector de fecha con 3 ruedas (dia/mes/anio) en vez de texto libre, para
// que sea imposible escribir una fecha con formato invalido. Se precarga
// con la fecha de "hoy" desde Rust al abrir un formulario nuevo.
component CampoFecha inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <int> dia <=> rueda-dia.value;
    in-out property <int> mes <=> rueda-mes.value;
    in-out property <int> anio <=> rueda-anio.value;
    height: 36px;
    spacing: 6px;
    alignment: start;
    Text { text: root.etiqueta; width: 190px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
    rueda-dia := SpinBox { minimum: 1; maximum: 31; width: 96px; horizontal-stretch: 0; }
    Text { text: "/"; width: 12px; color: #a0a0c0; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    rueda-mes := SpinBox { minimum: 1; maximum: 12; width: 96px; horizontal-stretch: 0; }
    Text { text: "/"; width: 12px; color: #a0a0c0; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
    rueda-anio := SpinBox { minimum: 2000; maximum: 2100; width: 110px; horizontal-stretch: 0; }
    Rectangle { horizontal-stretch: 1; }
}

// Campo para elegir un asesor (id_captador / id_cerrador / etc). Se puede
// escribir el nombre O el ID: a medida que se tipea aparece una lista de
// sugerencias debajo (nombre + ID) y al tocar una se completa el campo con
// el ID correcto. El valor que queda guardado en "valor" sigue siendo
// siempre el ID (igual que antes), asi que del lado de Rust no cambia nada
// del guardado/validacion: esto solo mejora la forma de cargar el dato.
component CampoAsesor inherits Rectangle {
    in property <string> etiqueta;
    in-out property <string> valor <=> entrada.text;
    // Lista completa de asesores (id + nombre), para poder mostrar el
    // nombre resuelto debajo del campo apenas el ID coincide con alguno.
    in property <[AsesorOpcion]> opciones;
    // Busqueda por texto parcial (nombre o ID); la logica de filtrado vive
    // en Rust porque el lenguaje .slint no tiene "contains" de strings.
    callback buscar(string) -> [AsesorOpcion];
    // Resuelve el nombre del asesor a partir del ID guardado en "valor".
    // Igual que "buscar", esta logica vive en Rust porque .slint no permite
    // bucles imperativos (for/return) dentro de una function.
    callback resolver-nombre(string) -> string;

    property <[AsesorOpcion]> sugerencias: [];
    property <bool> mostrar-sugerencias: false;
    property <string> nombre-resuelto-actual: root.valor == "" ? "" : root.resolver-nombre(root.valor);

    VerticalBox {
        padding: 0px;
        spacing: 2px;

        HorizontalBox {
            height: 32px;
            padding: 0px;
            spacing: 4px;
            Text { text: root.etiqueta; width: 130px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
            entrada := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Nombre o ID del asesor...";
                edited(texto) => {
                    if texto == "" {
                        root.sugerencias = [];
                        root.mostrar-sugerencias = false;
                    } else {
                        root.sugerencias = root.buscar(texto);
                        root.mostrar-sugerencias = root.sugerencias.length > 0;
                    }
                }
            }
        }

        if root.valor != "" && root.nombre-resuelto-actual != "": HorizontalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle { width: 134px; }
            Text {
                text: "✓ " + root.nombre-resuelto-actual;
                font-size: 11px;
                color: #6ee7a0;
            }
        }
        if root.valor != "" && root.nombre-resuelto-actual == "" && !root.mostrar-sugerencias: HorizontalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle { width: 134px; }
            Text {
                text: "No coincide con ningún ID de BD Asesores todavía";
                font-size: 11px;
                color: #e0a05a;
            }
        }

        if root.mostrar-sugerencias: HorizontalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle { width: 134px; }
            Rectangle {
            background: #20202f;
            border-radius: 6px;
            border-width: 1px;
            border-color: #33334d;
            VerticalBox {
                padding: 4px;
                spacing: 0px;
                for op in root.sugerencias: fila-sug := TouchArea {
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => {
                        root.valor = op.id;
                        root.mostrar-sugerencias = false;
                        root.sugerencias = [];
                    }
                    Rectangle {
                        background: fila-sug.has-hover ? #2a2a40 : transparent;
                        border-radius: 4px;
                        Text {
                            text: op.nombre + "   ·   " + op.id;
                            color: #e0e0f0;
                            font-size: 12px;
                            vertical-alignment: center;
                            x: 6px;
                        }
                    }
                }
                cerrar-sug := TouchArea {
                    height: 20px;
                    mouse-cursor: pointer;
                    clicked => { root.mostrar-sugerencias = false; }
                    Text {
                        text: "Cerrar sugerencias";
                        color: #7070a0;
                        font-size: 11px;
                        horizontal-alignment: right;
                        width: 100%;
                    }
                }
            }
        }
    }
    }
}

export component AppWindow inherits Window {
    title: "InmoCore Analytics Pro";
    preferred-width: 1050px;
    preferred-height: 680px;
    background: #12121c;

    // 0=Dashboard 1=Asesores 2=Matching 3=Legal 4=Embudo
    // 5=Cierres 6=Finanzas 7=Captaciones 8=Reportes
    property <int> pantalla: 0;

    // --- Dashboard ---
    in property <string> comisiones-oficina;
    in property <string> matches-disponibles;
    in property <string> expedientes-listos;
    in property <string> pagos-pendientes;
    callback actualizar-dashboard();

    // --- listados (todos usan TablaGenerica) ---
    in property <[Fila]> asesores-rows;
    callback actualizar-asesores();
    callback eliminar-asesor(int);

    // --- autocompletado por nombre/ID en los campos de asesor ---
    in property <[AsesorOpcion]> asesores-opciones;
    callback buscar-asesores(string) -> [AsesorOpcion];
    // Dado un ID de asesor, devuelve su nombre (o "" si no existe). Usado por
    // CampoAsesor para mostrar el "✓ Nombre" debajo del campo.
    callback resolver-nombre-asesor(string) -> string;

    // --- alta: Asesor ---
    in-out property <bool> mostrar-form-asesor: false;
    in-out property <string> asesor-id;
    in-out property <string> asesor-nombre;
    in-out property <int> asesor-fecha-ingreso-dia: 1;
    in-out property <int> asesor-fecha-ingreso-mes: 1;
    in-out property <int> asesor-fecha-ingreso-anio: 2026;
    in-out property <string> asesor-talleres;
    in property <string> mensaje-asesor;
    callback guardar-asesor();
    in-out property <int> asesor-editando: -1;
    callback editar-asesor(int);
    callback nuevo-asesor();

    in property <[Fila]> matching-rows;
    callback actualizar-matching();
    callback eliminar-matching(int);

    // --- alta: Matching ---
    in-out property <bool> mostrar-form-matching: false;
    in-out property <string> matching-id;
    in-out property <string> matching-cliente;
    in-out property <string> matching-asesor;
    in-out property <string> matching-tipo-operacion;
    in-out property <string> matching-zona;
    in-out property <string> matching-presupuesto;
    in-out property <string> matching-inmueble;
    in-out property <string> matching-precio;
    in-out property <int> matching-fecha-venc-dia: 1;
    in-out property <int> matching-fecha-venc-mes: 1;
    in-out property <int> matching-fecha-venc-anio: 2026;
    in property <string> mensaje-matching;
    callback guardar-matching();
    in-out property <int> matching-editando: -1;
    callback editar-matching(int);
    callback nuevo-matching();

    in property <[Fila]> legal-rows;
    callback actualizar-legal();
    callback eliminar-legal(int);

    // --- alta: Legal ---
    in-out property <bool> mostrar-form-legal: false;
    in-out property <string> legal-cod-inmueble;
    in-out property <string> legal-propietario;
    in-out property <bool> legal-titulo;
    in-out property <bool> legal-cedula;
    in-out property <bool> legal-catastral;
    in-out property <bool> legal-solvencia;
    in-out property <string> legal-liberacion-hipoteca;
    in-out property <string> legal-borrador-contrato;
    in-out property <string> legal-estatus-notaria;
    in property <string> mensaje-legal;
    callback guardar-legal();
    in-out property <int> legal-editando: -1;
    callback editar-legal(int);
    callback nuevo-legal();

    in property <[Fila]> embudo-rows;
    callback actualizar-embudo();
    callback eliminar-embudo(int);

    // --- alta: Embudo ---
    in-out property <bool> mostrar-form-embudo: false;
    in-out property <string> embudo-id-asesor;
    in-out property <string> embudo-nombre-asesor;
    in-out property <string> embudo-llamadas;
    in-out property <string> embudo-citas;
    in-out property <string> embudo-visitas;
    in-out property <string> embudo-ofertas;
    in-out property <string> embudo-cierres;
    in property <string> mensaje-embudo;
    callback guardar-embudo();
    in-out property <int> embudo-editando: -1;
    callback editar-embudo(int);
    callback nuevo-embudo();

    in property <[Fila]> cierres-rows;
    callback actualizar-cierres();
    callback eliminar-cierre(int);

    in property <[Fila]> finanzas-rows;
    in property <string> finanzas-total-pagado;
    in property <string> finanzas-total-pendiente;
    callback actualizar-finanzas();
    callback eliminar-finanza(int);

    in property <[Fila]> captaciones-rows;
    in property <string> captaciones-disponibles;
    in property <string> captaciones-cerradas;
    in property <string> captaciones-otros;
    callback actualizar-captaciones();
    callback eliminar-captacion(int);

    in property <[Fila]> reportes-rows;
    callback actualizar-reportes();
    callback eliminar-reporte(int);

    // --- alta: Reporte Propietario ---
    in-out property <bool> mostrar-form-reporte: false;
    in-out property <string> reporte-cod-inmueble;
    in-out property <string> reporte-propietario;
    in-out property <string> reporte-telefono;
    in-out property <string> reporte-id-asesor;
    in-out property <string> reporte-visitas;
    in-out property <string> reporte-ofertas;
    in-out property <string> reporte-canales;
    in-out property <string> reporte-notas;
    in-out property <string> reporte-estatus-envio;
    in property <string> mensaje-reporte;
    callback guardar-reporte();
    in-out property <int> reporte-editando: -1;
    callback editar-reporte(int);
    callback nuevo-reporte();

    // --- alta: Cierre ---
    in-out property <bool> mostrar-form-cierre: false;
    in-out property <string> cierre-id;
    in-out property <int> cierre-fecha-dia: 1;
    in-out property <int> cierre-fecha-mes: 1;
    in-out property <int> cierre-fecha-anio: 2026;
    in-out property <string> cierre-cod-inmueble;
    in-out property <string> cierre-tipo-operacion;
    in-out property <string> cierre-monto;
    in-out property <string> cierre-id-captador;
    in-out property <string> cierre-id-cerrador;
    in-out property <string> cierre-pct-comision;
    in property <string> mensaje-cierre;
    callback guardar-cierre();
    in-out property <int> cierre-editando: -1;
    callback editar-cierre(int);
    callback nuevo-cierre();

    // --- alta: Captacion ---
    in-out property <bool> mostrar-form-captacion: false;
    in-out property <string> captacion-cod-inmueble;
    in-out property <string> captacion-tipo-propiedad;
    in-out property <string> captacion-id-captador;
    in-out property <int> captacion-fecha-dia: 1;
    in-out property <int> captacion-fecha-mes: 1;
    in-out property <int> captacion-fecha-anio: 2026;
    in-out property <string> captacion-precio;
    in-out property <string> captacion-estatus;
    in-out property <bool> captacion-web;
    in-out property <bool> captacion-rrss;
    in property <string> mensaje-captacion;
    callback guardar-captacion();
    in-out property <int> captacion-editando: -1;
    callback editar-captacion(int);
    callback nuevo-captacion();

    // --- alta: Finanza ---
    in-out property <bool> mostrar-form-finanza: false;
    in-out property <string> finanza-id;
    in-out property <int> finanza-fecha-dia: 1;
    in-out property <int> finanza-fecha-mes: 1;
    in-out property <int> finanza-fecha-anio: 2026;
    in-out property <string> finanza-semana;
    in-out property <string> finanza-tipo-flujo;
    in-out property <string> finanza-categoria;
    in-out property <string> finanza-monto;
    in-out property <string> finanza-estatus;
    in property <string> mensaje-finanza;
    callback guardar-finanza();
    in-out property <int> finanza-editando: -1;
    callback editar-finanza(int);
    callback nuevo-finanza();

    HorizontalLayout {
        Rectangle {
            width: 190px;
            background: #181824;
            VerticalBox {
                padding: 10px;
                spacing: 4px;
                Text { text: "InmoCore"; font-size: 16px; font-weight: 700; color: #ffffff; }
                Rectangle { height: 10px; }
                NavButton { etiqueta: "Dashboard"; activo: root.pantalla == 0; clicked => { root.pantalla = 0; root.actualizar-dashboard(); } }
                NavButton { etiqueta: "BD Asesores"; activo: root.pantalla == 1; clicked => { root.pantalla = 1; root.actualizar-asesores(); } }
                NavButton { etiqueta: "Matching Redes"; activo: root.pantalla == 2; clicked => { root.pantalla = 2; root.actualizar-matching(); } }
                NavButton { etiqueta: "Checklist Legal"; activo: root.pantalla == 3; clicked => { root.pantalla = 3; root.actualizar-legal(); } }
                NavButton { etiqueta: "Embudo Operativo"; activo: root.pantalla == 4; clicked => { root.pantalla = 4; root.actualizar-embudo(); } }
                NavButton { etiqueta: "BD Cierres"; activo: root.pantalla == 5; clicked => { root.pantalla = 5; root.actualizar-cierres(); } }
                NavButton { etiqueta: "BD Finanzas"; activo: root.pantalla == 6; clicked => { root.pantalla = 6; root.actualizar-finanzas(); } }
                NavButton { etiqueta: "BD Captaciones"; activo: root.pantalla == 7; clicked => { root.pantalla = 7; root.actualizar-captaciones(); } }
                NavButton { etiqueta: "Reporte Propietario"; activo: root.pantalla == 8; clicked => { root.pantalla = 8; root.actualizar-reportes(); } }
            }
        }

        Rectangle {
            // --- 0: Dashboard ---
            if root.pantalla == 0: VerticalBox {
                padding: 24px;
                spacing: 16px;
                Text { text: "Dashboard"; font-size: 22px; font-weight: 700; color: #ffffff; }
                HorizontalBox {
                    spacing: 16px;
                    height: 140px;
                    KpiCard { etiqueta: "Comisiones oficina"; valor: root.comisiones-oficina; }
                    KpiCard { etiqueta: "Matches disponibles"; valor: root.matches-disponibles; }
                    KpiCard { etiqueta: "Expedientes listos p/firma"; valor: root.expedientes-listos; }
                    KpiCard { etiqueta: "Pagos pendientes"; valor: root.pagos-pendientes; }
                }
                Button { text: "Actualizar"; clicked => { root.actualizar-dashboard(); } }
                Rectangle {}
            }

            // --- 1: BD_Asesores (+ alta) ---
            if root.pantalla == 1: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "BD Asesores"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button {
                        text: root.mostrar-form-asesor ? "Cerrar formulario" : "Nuevo asesor";
                        clicked => {
                            if root.mostrar-form-asesor {
                                root.mostrar-form-asesor = false;
                            } else {

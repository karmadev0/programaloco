import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox } from "std-widgets.slint";

export struct Fila {
    celdas: [string],
}

component KpiCard inherits Rectangle {
    in property <string> etiqueta;
    in property <string> valor;
    background: #1e1e2e;
    border-radius: 10px;
    border-width: 1px;
    border-color: #33334d;
    VerticalBox {
        alignment: center;
        Text { text: root.valor; font-size: 26px; font-weight: 700; color: #ffffff; horizontal-alignment: center; }
        Text { text: root.etiqueta; font-size: 13px; color: #a0a0c0; horizontal-alignment: center; wrap: word-wrap; }
    }
}

component TablaGenerica inherits Rectangle {
    in property <[string]> headers;
    in property <[Fila]> rows;

    VerticalBox {
        padding: 0px;
        spacing: 4px;

        HorizontalBox {
            padding: 6px;
            for h in root.headers: Text {
                text: h;
                font-size: 12px;
                font-weight: 700;
                color: #a0a0c0;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        Rectangle { height: 1px; background: #33334d; }

        ScrollView {
            VerticalBox {
                padding: 0px;
                spacing: 0px;
                for fila[i] in root.rows: Rectangle {
                    background: mod(i, 2) == 0 ? #1a1a26 : transparent;
                    HorizontalBox {
                        padding: 6px;
                        for celda in fila.celdas: Text {
                            text: celda;
                            font-size: 12px;
                            color: #e0e0f0;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> etiqueta;
    in property <bool> activo;
    callback clicked();
    height: 38px;
    background: root.activo ? #2a2a40 : transparent;
    border-radius: 6px;
    Text {
        text: root.etiqueta;
        color: root.activo ? #ffffff : #a0a0c0;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 10px;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Campo de texto con etiqueta, para los 3 formularios de alta.
component CampoTexto inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <string> valor <=> entrada.text;
    height: 32px;
    Text { text: root.etiqueta; width: 130px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
    entrada := LineEdit { horizontal-stretch: 1; }
}

// Checkbox con etiqueta, para publicado_web / publicado_rrss.
component CampoCheck inherits HorizontalBox {
    in property <string> etiqueta;
    in-out property <bool> valor <=> caja.checked;
    height: 32px;
    caja := CheckBox { text: root.etiqueta; }
}

export component AppWindow inherits Window {
    title: "InmoCore Analytics Pro";
    preferred-width: 1050px;
    preferred-height: 680px;
    background: #12121c;

    // 0=Dashboard 1=Asesores 2=Matching 3=Legal 4=Embudo
    // 5=Cierres 6=Finanzas 7=Captaciones 8=Reportes
    property <int> pantalla: 0;

    // --- Dashboard ---
    in property <string> comisiones-oficina;
    in property <string> matches-disponibles;
    in property <string> expedientes-listos;
    in property <string> pagos-pendientes;
    callback actualizar-dashboard();

    // --- listados (todos usan TablaGenerica) ---
    in property <[Fila]> asesores-rows;
    callback actualizar-asesores();

    // --- alta: Asesor ---
    property <bool> mostrar-form-asesor: false;
    in-out property <string> asesor-id;
    in-out property <string> asesor-nombre;
    in-out property <string> asesor-fecha-ingreso;
    in-out property <string> asesor-talleres;
    in property <string> mensaje-asesor;
    callback guardar-asesor();

    in property <[Fila]> matching-rows;
    callback actualizar-matching();

    in property <[Fila]> legal-rows;
    callback actualizar-legal();

    in property <[Fila]> embudo-rows;
    callback actualizar-embudo();

    in property <[Fila]> cierres-rows;
    callback actualizar-cierres();

    in property <[Fila]> finanzas-rows;
    in property <string> finanzas-total-pagado;
    in property <string> finanzas-total-pendiente;
    callback actualizar-finanzas();

    in property <[Fila]> captaciones-rows;
    callback actualizar-captaciones();

    in property <[Fila]> reportes-rows;
    callback actualizar-reportes();

    // --- alta: Cierre ---
    property <bool> mostrar-form-cierre: false;
    in-out property <string> cierre-id;
    in-out property <string> cierre-fecha;
    in-out property <string> cierre-cod-inmueble;
    in-out property <string> cierre-tipo-operacion;
    in-out property <string> cierre-monto;
    in-out property <string> cierre-id-captador;
    in-out property <string> cierre-id-cerrador;
    in-out property <string> cierre-pct-comision;
    in property <string> mensaje-cierre;
    callback guardar-cierre();

    // --- alta: Captacion ---
    property <bool> mostrar-form-captacion: false;
    in-out property <string> captacion-cod-inmueble;
    in-out property <string> captacion-tipo-propiedad;
    in-out property <string> captacion-id-captador;
    in-out property <string> captacion-fecha;
    in-out property <string> captacion-precio;
    in-out property <string> captacion-estatus;
    in-out property <bool> captacion-web;
    in-out property <bool> captacion-rrss;
    in property <string> mensaje-captacion;
    callback guardar-captacion();

    // --- alta: Finanza ---
    property <bool> mostrar-form-finanza: false;
    in-out property <string> finanza-id;
    in-out property <string> finanza-fecha;
    in-out property <string> finanza-semana;
    in-out property <string> finanza-tipo-flujo;
    in-out property <string> finanza-categoria;
    in-out property <string> finanza-monto;
    in-out property <string> finanza-estatus;
    in property <string> mensaje-finanza;
    callback guardar-finanza();

    HorizontalLayout {
        Rectangle {
            width: 190px;
            background: #181824;
            VerticalBox {
                padding: 10px;
                spacing: 4px;
                Text { text: "InmoCore"; font-size: 16px; font-weight: 700; color: #ffffff; }
                Rectangle { height: 10px; }
                NavButton { etiqueta: "Dashboard"; activo: root.pantalla == 0; clicked => { root.pantalla = 0; root.actualizar-dashboard(); } }
                NavButton { etiqueta: "BD Asesores"; activo: root.pantalla == 1; clicked => { root.pantalla = 1; root.actualizar-asesores(); } }
                NavButton { etiqueta: "Matching Redes"; activo: root.pantalla == 2; clicked => { root.pantalla = 2; root.actualizar-matching(); } }
                NavButton { etiqueta: "Checklist Legal"; activo: root.pantalla == 3; clicked => { root.pantalla = 3; root.actualizar-legal(); } }
                NavButton { etiqueta: "Embudo Operativo"; activo: root.pantalla == 4; clicked => { root.pantalla = 4; root.actualizar-embudo(); } }
                NavButton { etiqueta: "BD Cierres"; activo: root.pantalla == 5; clicked => { root.pantalla = 5; root.actualizar-cierres(); } }
                NavButton { etiqueta: "BD Finanzas"; activo: root.pantalla == 6; clicked => { root.pantalla = 6; root.actualizar-finanzas(); } }
                NavButton { etiqueta: "BD Captaciones"; activo: root.pantalla == 7; clicked => { root.pantalla = 7; root.actualizar-captaciones(); } }
                NavButton { etiqueta: "Reporte Propietario"; activo: root.pantalla == 8; clicked => { root.pantalla = 8; root.actualizar-reportes(); } }
            }
        }

        Rectangle {
            // --- 0: Dashboard ---
            if root.pantalla == 0: VerticalBox {
                padding: 24px;
                spacing: 16px;
                Text { text: "Dashboard"; font-size: 22px; font-weight: 700; color: #ffffff; }
                HorizontalBox {
                    spacing: 16px;
                    height: 140px;
                    KpiCard { etiqueta: "Comisiones oficina"; valor: root.comisiones-oficina; }
                    KpiCard { etiqueta: "Matches disponibles"; valor: root.matches-disponibles; }
                    KpiCard { etiqueta: "Expedientes listos p/firma"; valor: root.expedientes-listos; }
                    KpiCard { etiqueta: "Pagos pendientes"; valor: root.pagos-pendientes; }
                }
                Button { text: "Actualizar"; clicked => { root.actualizar-dashboard(); } }
                Rectangle {}
            }

            // --- 1: BD_Asesores (+ alta) ---
            if root.pantalla == 1: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "BD Asesores"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: root.mostrar-form-asesor ? "Cerrar formulario" : "Nuevo asesor"; clicked => { root.mostrar-form-asesor = !root.mostrar-form-asesor; } }
                    Button { text: "Actualizar"; clicked => { root.actualizar-asesores(); } }
                }
                if root.mostrar-form-asesor: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;
                        CampoTexto { etiqueta: "ID (ej. AS-004)"; valor <=> root.asesor-id; }
                        CampoTexto { etiqueta: "Nombre"; valor <=> root.asesor-nombre; }
                        CampoTexto { etiqueta: "Fecha ingreso (YYYY-MM-DD)"; valor <=> root.asesor-fecha-ingreso; }
                        CampoTexto { etiqueta: "Talleres asistidos"; valor <=> root.asesor-talleres; }
                        HorizontalBox {
                            Button { text: "Guardar"; clicked => { root.guardar-asesor(); } }
                            Text { text: root.mensaje-asesor; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                TablaGenerica {
                    headers: ["ID", "Nombre", "Ventas", "Alquileres", "Facturado", "% Asistencia", "Score", "Ranking"];
                    rows: root.asesores-rows;
                }
            }

            // --- 2: Matching_Redes ---
            if root.pantalla == 2: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "Matching Redes"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: "Actualizar"; clicked => { root.actualizar-matching(); } }
                }
                TablaGenerica {
                    headers: ["ID", "Cliente", "Asesor", "Tipo Op", "Zona", "Presup. Max", "Inmueble", "Precio Lista", "Venc. Exclusiv.", "Días Venc.", "Nivel Match"];
                    rows: root.matching-rows;
                }
            }

            // --- 3: Checklist_Legal ---
            if root.pantalla == 3: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "Checklist Legal"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: "Actualizar"; clicked => { root.actualizar-legal(); } }
                }
                TablaGenerica {
                    headers: ["Cod. Inmueble", "Propietario", "Título", "Cédula/RIF", "Catastral", "Solvencia", "Lib. Hipoteca", "Borrador Contrato", "Notaría", "Estatus"];
                    rows: root.legal-rows;
                }
            }

            // --- 4: Embudo_Operativo ---
            if root.pantalla == 4: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "Embudo Operativo"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: "Actualizar"; clicked => { root.actualizar-embudo(); } }
                }
                TablaGenerica {
                    headers: ["ID Asesor", "Nombre", "Llamadas", "Citas", "Visitas", "Ofertas", "Cierres", "Tasa Conv.", "Nivel Actividad"];
                    rows: root.embudo-rows;
                }
            }

            // --- 5: BD_Cierres (+ alta) ---
            if root.pantalla == 5: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "BD Cierres"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: root.mostrar-form-cierre ? "Cerrar formulario" : "Nuevo cierre"; clicked => { root.mostrar-form-cierre = !root.mostrar-form-cierre; } }
                    Button { text: "Actualizar"; clicked => { root.actualizar-cierres(); } }
                }
                if root.mostrar-form-cierre: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;
                        CampoTexto { etiqueta: "ID"; valor <=> root.cierre-id; }
                        CampoTexto { etiqueta: "Fecha (YYYY-MM-DD)"; valor <=> root.cierre-fecha; }
                        CampoTexto { etiqueta: "Cod. Inmueble"; valor <=> root.cierre-cod-inmueble; }
                        CampoTexto { etiqueta: "Tipo (Venta/Alquiler)"; valor <=> root.cierre-tipo-operacion; }
                        CampoTexto { etiqueta: "Monto operación"; valor <=> root.cierre-monto; }
                        CampoTexto { etiqueta: "ID Captador"; valor <=> root.cierre-id-captador; }
                        CampoTexto { etiqueta: "ID Cerrador"; valor <=> root.cierre-id-cerrador; }
                        CampoTexto { etiqueta: "% Comisión (0.05=5%)"; valor <=> root.cierre-pct-comision; }
                        HorizontalBox {
                            Button { text: "Guardar"; clicked => { root.guardar-cierre(); } }
                            Text { text: root.mensaje-cierre; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                TablaGenerica {
                    headers: ["ID", "Fecha", "Cod. Inmueble", "Tipo Op", "Monto", "Captador", "Cerrador", "% Comisión", "Com. Oficina", "Pago Asesores"];
                    rows: root.cierres-rows;
                }
            }

            // --- 6: BD_Finanzas (+ alta) ---
            if root.pantalla == 6: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "BD Finanzas"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: root.mostrar-form-finanza ? "Cerrar formulario" : "Nueva transacción"; clicked => { root.mostrar-form-finanza = !root.mostrar-form-finanza; } }
                    Button { text: "Actualizar"; clicked => { root.actualizar-finanzas(); } }
                }
                HorizontalBox {
                    spacing: 16px;
                    height: 90px;
                    KpiCard { etiqueta: "Total pagado"; valor: root.finanzas-total-pagado; }
                    KpiCard { etiqueta: "Total pendiente"; valor: root.finanzas-total-pendiente; }
                }
                if root.mostrar-form-finanza: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;
                        CampoTexto { etiqueta: "ID"; valor <=> root.finanza-id; }
                        CampoTexto { etiqueta: "Fecha (YYYY-MM-DD)"; valor <=> root.finanza-fecha; }
                        CampoTexto { etiqueta: "Semana"; valor <=> root.finanza-semana; }
                        CampoTexto { etiqueta: "Tipo (Ingreso/Egreso)"; valor <=> root.finanza-tipo-flujo; }
                        CampoTexto { etiqueta: "Categoría"; valor <=> root.finanza-categoria; }
                        CampoTexto { etiqueta: "Monto"; valor <=> root.finanza-monto; }
                        CampoTexto { etiqueta: "Estatus (Pagado/Pendiente)"; valor <=> root.finanza-estatus; }
                        HorizontalBox {
                            Button { text: "Guardar"; clicked => { root.guardar-finanza(); } }
                            Text { text: root.mensaje-finanza; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                TablaGenerica {
                    headers: ["ID", "Fecha", "Semana", "Tipo Flujo", "Categoría", "Monto", "Estatus"];
                    rows: root.finanzas-rows;
                }
            }

            // --- 7: BD_Captaciones (+ alta) ---
            if root.pantalla == 7: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "BD Captaciones"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: root.mostrar-form-captacion ? "Cerrar formulario" : "Nueva captación"; clicked => { root.mostrar-form-captacion = !root.mostrar-form-captacion; } }
                    Button { text: "Actualizar"; clicked => { root.actualizar-captaciones(); } }
                }
                if root.mostrar-form-captacion: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    VerticalBox {
                        padding: 12px;
                        spacing: 4px;
                        CampoTexto { etiqueta: "Cod. Inmueble"; valor <=> root.captacion-cod-inmueble; }
                        CampoTexto { etiqueta: "Tipo Propiedad"; valor <=> root.captacion-tipo-propiedad; }
                        CampoTexto { etiqueta: "ID Captador"; valor <=> root.captacion-id-captador; }
                        CampoTexto { etiqueta: "Fecha (YYYY-MM-DD)"; valor <=> root.captacion-fecha; }
                        CampoTexto { etiqueta: "Precio Lista"; valor <=> root.captacion-precio; }
                        CampoTexto { etiqueta: "Estatus"; valor <=> root.captacion-estatus; }
                        HorizontalBox {
                            spacing: 16px;
                            CampoCheck { etiqueta: "Publicado Web"; valor <=> root.captacion-web; }
                            CampoCheck { etiqueta: "Publicado RRSS"; valor <=> root.captacion-rrss; }
                        }
                        HorizontalBox {
                            Button { text: "Guardar"; clicked => { root.guardar-captacion(); } }
                            Text { text: root.mensaje-captacion; color: #a0a0c0; font-size: 12px; vertical-alignment: center; }
                        }
                    }
                }
                TablaGenerica {
                    headers: ["Cod. Inmueble", "Tipo", "Captador", "Fecha", "Precio Lista", "Estatus", "Web", "RRSS"];
                    rows: root.captaciones-rows;
                }
            }

            // --- 8: Reporte_Propietario ---
            if root.pantalla == 8: VerticalBox {
                padding: 24px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "Reporte Propietario"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: "Actualizar"; clicked => { root.actualizar-reportes(); } }
                }
                TablaGenerica {
                    headers: ["Cod. Inmueble", "Propietario", "Teléfono", "Asesor", "Visitas", "Ofertas", "Canales", "Notas", "Estatus Envío"];
                    rows: root.reportes-rows;
                }
            }
        }
    }
}

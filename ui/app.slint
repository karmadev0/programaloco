import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit, ComboBox } from "std-widgets.slint";

export struct Fila {
    celdas: [string],
}

// Un campo de formulario. "opciones" vacio = texto libre; con opciones = lista desplegable.
export struct Campo {
    etiqueta: string,
    valor: string,
    opciones: [string],
}

export struct Kpi {
    etiqueta: string,
    valor: string,
}

// valor: 0..1 (proporcion respecto a la barra mas larga); texto: lo que se muestra al lado.
export struct Barra {
    etiqueta: string,
    valor: float,
    texto: string,
}

export struct Grafico {
    titulo: string,
    barras: [Barra],
}

component KpiCard inherits Rectangle {
    in property <string> etiqueta;
    in property <string> valor;
    background: #1e1e2e;
    border-radius: 10px;
    border-width: 1px;
    border-color: #33334d;
    VerticalBox {
        alignment: center;
        Text { text: root.valor; font-size: 20px; font-weight: 700; color: #ffffff; horizontal-alignment: center; overflow: elide; }
        Text { text: root.etiqueta; font-size: 12px; color: #a0a0c0; horizontal-alignment: center; wrap: word-wrap; }
    }
}

// Tabla generica. "visibles" = cuantas columnas caben en la fila; el resto de las
// columnas solo aparece en el cuadro de detalle (pasar el mouse o tocar la fila).
component TablaGenerica inherits Rectangle {
    in property <[string]> headers;
    in property <int> visibles: -1;
    in property <[Fila]> rows;
    in property <bool> puede-editar: true;
    in property <bool> puede-eliminar: true;
    callback eliminar(int);
    callback editar(int);

    // Confirmacion de borrado: primer toque arma, segundo toque confirma.
    property <int> fila-a-confirmar: -1;
    // Fila "fijada" por un toque (para pantallas tactiles, sin hover).
    property <int> fila-fijada: -1;
    changed rows => { root.fila-a-confirmar = -1; root.fila-fijada = -1; }

    property <int> n-cols: root.visibles < 0 ? root.headers.length : root.visibles;
    property <length> ancho-botones: (root.puede-editar ? 60px : 0px) + (root.puede-eliminar ? 78px : 0px);
    // Ancho de columna COMPARTIDO por el header y todas las filas (asi quedan alineadas).
    property <length> ancho-columna: (root.width - root.ancho-botones - 24px) / max(1, root.n-cols);

    VerticalBox {
        padding: 0px;
        spacing: 4px;

        HorizontalBox {
            padding: 6px;
            spacing: 0px;
            for h[hi] in root.headers: Text {
                text: h;
                visible: hi < root.n-cols;
                width: hi < root.n-cols ? root.ancho-columna : 0px;
                horizontal-stretch: 0;
                font-size: 12px;
                font-weight: 700;
                color: #a0a0c0;
                overflow: elide;
                wrap: no-wrap;
            }
            Rectangle { width: root.ancho-botones; }
        }

        Rectangle { height: 1px; background: #33334d; }

        ScrollView {
            VerticalBox {
                padding: 0px;
                spacing: 2px;
                alignment: start;
                for fila[i] in root.rows: VerticalBox {
                    padding: 0px;
                    spacing: 0px;

                    Rectangle {
                        height: 34px;
                        vertical-stretch: 0;
                        background: mod(i, 2) == 0 ? #1a1a26 : transparent;

                        toque-fila := TouchArea {
                            clicked => {
                                root.fila-fijada = root.fila-fijada == i ? -1 : i;
                            }
                        }

                        HorizontalBox {
                            padding: 6px;
                            spacing: 0px;
                            for celda[ci] in fila.celdas: Text {
                                text: celda;
                                visible: ci < root.n-cols;
                                width: ci < root.n-cols ? root.ancho-columna : 0px;
                                horizontal-stretch: 0;
                                font-size: 12px;
                                color: #e0e0f0;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                            if root.puede-editar: Button { text: "Editar"; width: 60px; vertical-stretch: 0; clicked => { root.editar(i); } }
                            if root.puede-eliminar: Button {
                                text: root.fila-a-confirmar == i ? "¿Seguro?" : "Eliminar";
                                width: 78px;
                                vertical-stretch: 0;
                                clicked => {
                                    if root.fila-a-confirmar == i {
                                        root.fila-a-confirmar = -1;
                                        root.eliminar(i);
                                    } else {
                                        root.fila-a-confirmar = i;
                                    }
                                }
                            }
                        }
                    }

                    // Detalle completo de la fila (hover en desktop / toque en pantallas tactiles).
                    if toque-fila.has-hover || root.fila-fijada == i: Rectangle {
                        background: #23233a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #3a3a55;
                        VerticalBox {
                            padding: 8px;
                            spacing: 2px;
                            for h[idx] in root.headers: Text {
                                text: h + ": " + fila.celdas[idx];
                                font-size: 12px;
                                color: #e0e0f0;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> etiqueta;
    in property <bool> activo;
    callback clicked();
    height: 34px;
    background: root.activo ? #2a2a40 : transparent;
    border-radius: 6px;
    Text {
        text: root.etiqueta;
        color: root.activo ? #ffffff : #a0a0c0;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: left;
        x: 10px;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Tarjeta de la seccion Ayuda.
component TarjetaAyuda inherits Rectangle {
    in property <string> titulo;
    in property <string> para-que-sirve;
    background: #1a1a26;
    border-radius: 8px;
    VerticalBox {
        padding: 14px;
        spacing: 6px;
        Text { text: root.titulo; font-size: 15px; font-weight: 700; color: #ffffff; }
        Text { text: root.para-que-sirve; font-size: 13px; color: #d0d0e0; wrap: word-wrap; }
    }
}

export component AppWindow inherits Window {
    title: "InmoCore — KAVELA Servicios Inmobiliarios";
    preferred-width: 1180px;
    preferred-height: 740px;
    background: #12121c;

    // 0=Dashboard 1=Negocios 2=Asesores 3=Mensualidad 4=Finanzas 5=Inventario 6=CRM
    // 7=Guardia 8=TOP Mensual 9=Rankings 10=Configuracion 11=Graficos 12=Ayuda
    in-out property <int> pantalla: 0;
    callback ir-a(int);

    // --- Dashboard ---
    in property <[Kpi]> kpis;
    in property <[Kpi]> honor;
    in property <[string]> dash-headers;
    in property <[Fila]> dash-rows;

    // --- Pantalla generica (Negocios, Asesores, Mensualidad, Finanzas, Inventario, CRM,
    //     Guardia, TOP, Rankings, Configuracion) ---
    in property <string> titulo;
    in property <string> ayuda;
    in property <[string]> headers;
    in property <int> visibles;
    in property <[Fila]> rows;
    in property <bool> puede-crear;
    in property <bool> puede-editar;
    in property <bool> puede-eliminar;
    in property <string> mensaje;
    callback nuevo();
    callback editar(int);
    callback eliminar(int);

    // --- Formulario (se muestra en lugar de la tabla) ---
    in-out property <bool> mostrar-form: false;
    in property <[Campo]> campos;
    in property <bool> editando;
    callback campo-editado(int, string);
    callback guardar();
    callback cancelar();

    // --- Guardia juridica: buscador por fecha ---
    in property <string> guardia-resultado;
    callback consultar-guardia(string);

    // --- Graficos ---
    in property <[Grafico]> graficos;

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: #181824;
            VerticalBox {
                padding: 10px;
                spacing: 3px;
                alignment: start;
                Text { text: "InmoCore"; font-size: 16px; font-weight: 700; color: #ffffff; }
                Text { text: "KAVELA Servicios Inmobiliarios"; font-size: 10px; color: #a0a0c0; wrap: word-wrap; }
                Rectangle { height: 8px; }
                NavButton { etiqueta: "Dashboard"; activo: root.pantalla == 0; clicked => { root.ir-a(0); } }
                NavButton { etiqueta: "Registro Negocios"; activo: root.pantalla == 1; clicked => { root.ir-a(1); } }
                NavButton { etiqueta: "Asesores"; activo: root.pantalla == 2; clicked => { root.ir-a(2); } }
                NavButton { etiqueta: "Mensualidad"; activo: root.pantalla == 3; clicked => { root.ir-a(3); } }
                NavButton { etiqueta: "Finanzas"; activo: root.pantalla == 4; clicked => { root.ir-a(4); } }
                NavButton { etiqueta: "Inventario"; activo: root.pantalla == 5; clicked => { root.ir-a(5); } }
                NavButton { etiqueta: "CRM Clientes"; activo: root.pantalla == 6; clicked => { root.ir-a(6); } }
                NavButton { etiqueta: "Guardia Jurídica"; activo: root.pantalla == 7; clicked => { root.ir-a(7); } }
                NavButton { etiqueta: "TOP Mensual"; activo: root.pantalla == 8; clicked => { root.ir-a(8); } }
                NavButton { etiqueta: "Rankings"; activo: root.pantalla == 9; clicked => { root.ir-a(9); } }
                NavButton { etiqueta: "Gráficos"; activo: root.pantalla == 11; clicked => { root.ir-a(11); } }
                NavButton { etiqueta: "Configuración"; activo: root.pantalla == 10; clicked => { root.ir-a(10); } }
                NavButton { etiqueta: "Ayuda"; activo: root.pantalla == 12; clicked => { root.ir-a(12); } }
            }
        }

        Rectangle {
            // --- 0: Dashboard ---
            if root.pantalla == 0: VerticalBox {
                padding: 20px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "Tablero ejecutivo"; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    Button { text: "Actualizar"; clicked => { root.ir-a(0); } }
                }
                HorizontalBox {
                    spacing: 10px;
                    height: 84px;
                    for k in root.kpis: KpiCard { etiqueta: k.etiqueta; valor: k.valor; }
                }
                Text { text: "Cuadro de honor — período completo"; font-size: 13px; font-weight: 700; color: #a0a0c0; }
                HorizontalBox {
                    spacing: 10px;
                    height: 74px;
                    for k in root.honor: KpiCard { etiqueta: k.etiqueta; valor: k.valor; }
                }
                Text { text: "Desempeño acumulado por asesor"; font-size: 13px; font-weight: 700; color: #a0a0c0; }
                TablaGenerica {
                    headers: root.dash-headers;
                    rows: root.dash-rows;
                    puede-editar: false;
                    puede-eliminar: false;
                }
            }

            // --- 11: Graficos ---
            if root.pantalla == 11: VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { text: "Gráficos y estadísticas"; font-size: 22px; font-weight: 700; color: #ffffff; }
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        spacing: 14px;
                        for g in root.graficos: Rectangle {
                            background: #1a1a26;
                            border-radius: 8px;
                            VerticalBox {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: g.titulo; font-size: 15px; font-weight: 700; color: #ffffff; }
                                for b in g.barras: HorizontalBox {
                                    padding: 0px;
                                    spacing: 8px;
                                    height: 24px;
                                    Text { text: b.etiqueta; width: 150px; font-size: 12px; color: #d0d0e0; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        background: #23233a;
                                        border-radius: 4px;
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width * b.valor;
                                            background: #6e8bff;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: b.texto; width: 110px; font-size: 12px; color: #e0e0f0; vertical-alignment: center; }
                                }
                                if g.barras.length == 0: Text { text: "Sin datos todavía."; font-size: 12px; color: #a0a0c0; }
                            }
                        }
                    }
                }
            }

            // --- 12: Ayuda ---
            if root.pantalla == 12: VerticalBox {
                padding: 20px;
                spacing: 10px;
                Text { text: "Cómo funciona"; font-size: 22px; font-weight: 700; color: #ffffff; }
                ScrollView {
                    VerticalBox {
                        alignment: start;
                        spacing: 10px;
                        TarjetaAyuda { titulo: "Regla general"; para-que-sirve: "Los negocios se cargan SOLO en Registro Negocios. Dashboard, Asesores, TOP Mensual, Rankings, Finanzas y Gráficos se calculan solos a partir de ahí."; }
                        TarjetaAyuda { titulo: "Registro Negocios"; para-que-sirve: "Cada negocio cerrado: fecha, asesor, formato % (lo que se lleva el asesor), puntas, monto, tipo y comisión total. Comisión del asesor = comisión total × formato %; comisión de la oficina = el resto."; }
                        TarjetaAyuda { titulo: "Asesores y puntaje"; para-que-sirve: "El puntaje del Dashboard = volumen × 0.5 + negocios × 200 + comisión del asesor × 0.3 + captaciones × 100. Una captación es un negocio donde el asesor aparece en 'Punta captadora'."; }
                        TarjetaAyuda { titulo: "Mensualidad"; para-que-sirve: "Cuota de $10 por agente. Día de pago ≤ 5: a tiempo · ≤ 15: con mora · más de 15: mora severa · sin día: pendiente. Use Editar para poner el día de pago."; }
                        TarjetaAyuda { titulo: "Finanzas"; para-que-sirve: "Ingresos = comisiones + mensualidades (automático). Los egresos (arriendo, servicios, marketing, nómina) se cargan con Editar en cada mes. Utilidad = ingresos − egresos."; }
                        TarjetaAyuda { titulo: "Inventario, CRM y Guardia"; para-que-sirve: "Inventario: propiedades en cartera. CRM: seguimiento de clientes (el % de cierre sale de la etapa). Guardia: abogado por día y buscador por fecha."; }
                    }
                }
            }

            // --- Pantalla generica ---
            if root.pantalla != 0 && root.pantalla != 11 && root.pantalla != 12: VerticalBox {
                padding: 20px;
                spacing: 10px;
                HorizontalBox {
                    Text { text: root.titulo; font-size: 22px; font-weight: 700; color: #ffffff; horizontal-stretch: 1; }
                    if root.mostrar-form: Button { text: "Cancelar"; clicked => { root.cancelar(); } }
                    if root.mostrar-form: Button { text: root.editando ? "Actualizar" : "Guardar"; primary: true; clicked => { root.guardar(); } }
                    if !root.mostrar-form && root.puede-crear: Button { text: "Nuevo"; primary: true; clicked => { root.nuevo(); } }
                    if !root.mostrar-form: Button { text: "Actualizar"; clicked => { root.ir-a(root.pantalla); } }
                }
                if root.ayuda != "" && !root.mostrar-form: Text { text: root.ayuda; font-size: 12px; color: #a0a0c0; wrap: word-wrap; }
                if root.mensaje != "": Text { text: root.mensaje; font-size: 13px; color: #6ee7a0; wrap: word-wrap; }

                // Buscador de la guardia (solo en esa pantalla)
                if root.pantalla == 7 && !root.mostrar-form: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    height: 50px;
                    HorizontalBox {
                        padding: 8px;
                        spacing: 8px;
                        Text { text: "Fecha a consultar:"; font-size: 12px; color: #a0a0c0; vertical-alignment: center; }
                        fecha-guardia := LineEdit { width: 150px; placeholder-text: "AAAA-MM-DD"; accepted(t) => { root.consultar-guardia(t); } }
                        Button { text: "Consultar"; clicked => { root.consultar-guardia(fecha-guardia.text); } }
                        Text { text: root.guardia-resultado; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }

                if root.mostrar-form: Rectangle {
                    background: #1a1a26;
                    border-radius: 8px;
                    ScrollView {
                        VerticalBox {
                            padding: 12px;
                            spacing: 4px;
                            alignment: start;
                            for c[i] in root.campos: HorizontalBox {
                                height: 34px;
                                spacing: 8px;
                                Text { text: c.etiqueta; width: 260px; color: #a0a0c0; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                                if c.opciones.length == 0: LineEdit {
                                    text: c.valor;
                                    horizontal-stretch: 1;
                                    edited(t) => { root.campo-editado(i, t); }
                                }
                                if c.opciones.length > 0: ComboBox {
                                    model: c.opciones;
                                    current-value: c.valor;
                                    horizontal-stretch: 1;
                                    selected(t) => { root.campo-editado(i, t); }
                                }
                            }
                        }
                    }
                }
                if !root.mostrar-form: TablaGenerica {
                    headers: root.headers;
                    visibles: root.visibles;
                    rows: root.rows;
                    puede-editar: root.puede-editar;
                    puede-eliminar: root.puede-eliminar;
                    editar(i) => { root.editar(i); }
                    eliminar(i) => { root.eliminar(i); }
                }
            }
        }
    }
}
